{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design.local/schemas/learning-proposal.schema.json",
  "title": "Design Learning Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "status", "source_projects", "observations", "evidence", "proposed_rule", "exceptions", "risks", "conflicting_rules", "destination", "evaluation", "privacy_review", "approval", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "proposal_id": {"type": "string", "minLength": 1},
    "status": {"const": "proposal-only"},
    "source_projects": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/project"}},
    "observations": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/observation"}},
    "evidence": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/evidence"}},
    "proposed_rule": {"type": "string", "minLength": 12},
    "exceptions": {"$ref": "#/$defs/strings"},
    "risks": {"$ref": "#/$defs/strings"},
    "conflicting_rules": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "destination": {"$ref": "#/$defs/destination"},
    "evaluation": {"$ref": "#/$defs/strings"},
    "privacy_review": {"$ref": "#/$defs/privacy"},
    "approval": {"$ref": "#/$defs/approval"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/hash"}}},
    "strings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "project": {"type": "object", "additionalProperties": false, "required": ["opaque_id", "visibility", "evidence_ref"], "properties": {"opaque_id": {"type": "string", "minLength": 1}, "visibility": {"enum": ["private", "internal", "public"]}, "evidence_ref": {"type": "string", "minLength": 1}}},
    "observation": {"type": "object", "additionalProperties": false, "required": ["source_project_id", "statement"], "properties": {"source_project_id": {"type": "string", "minLength": 1}, "statement": {"type": "string", "minLength": 1}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["id", "source_project_id", "artifact", "summary"], "properties": {"id": {"type": "string", "minLength": 1}, "source_project_id": {"type": "string", "minLength": 1}, "artifact": {"$ref": "#/$defs/artifact"}, "summary": {"type": "string", "minLength": 1}}},
    "destination": {"type": "object", "additionalProperties": false, "required": ["kind", "candidate", "write_performed"], "properties": {"kind": {"enum": ["skill", "reference", "corpus-rule", "template", "none"]}, "candidate": {"type": "string", "minLength": 1}, "write_performed": {"const": false}}},
    "privacy": {"type": "object", "additionalProperties": false, "required": ["status", "reviewer", "redactions", "review_artifact"], "properties": {"status": {"const": "pass"}, "reviewer": {"type": "string", "minLength": 1}, "redactions": {"type": "array", "items": {"type": "string", "minLength": 1}}, "review_artifact": {"$ref": "#/$defs/artifact"}}},
    "approval": {"type": "object", "additionalProperties": false, "required": ["status", "decision_text", "decided_at"], "properties": {"status": {"const": "pending"}, "decision_text": {"type": "null"}, "decided_at": {"type": "null"}}}
  }
}
