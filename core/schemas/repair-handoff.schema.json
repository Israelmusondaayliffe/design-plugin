{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design.local/schemas/repair-handoff.schema.json",
  "title": "Design Repair Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cycle_number", "pass_number", "status", "repair_plan_sha256", "changed_files", "completed_actions", "completed_checks", "target_results", "ended_at"],
  "properties": {
    "schema_version": {"const": "1.0"}, "cycle_number": {"type": "integer", "minimum": 1}, "pass_number": {"type": "integer", "minimum": 1, "maximum": 3}, "status": {"const": "applied"}, "repair_plan_sha256": {"$ref": "#/$defs/hash"},
    "changed_files": {"type": "array", "items": {"$ref": "#/$defs/changedFile"}},
    "completed_actions": {"$ref": "#/$defs/strings"},
    "completed_checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
    "target_results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/result"}},
    "ended_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "not": {"pattern": "(^/|(^|/)\\.\\.(/|$)|^[A-Za-z]:)"}},
    "strings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "changedFile": {
      "type": "object", "additionalProperties": false, "required": ["path", "change", "sha256", "evidence"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "change": {"const": "changed"}, "sha256": {"$ref": "#/$defs/hash"}, "evidence": {"type": "string", "minLength": 1}}
    },
    "check": {
      "type": "object", "additionalProperties": false, "required": ["check", "status", "evidence"],
      "properties": {"check": {"type": "string", "minLength": 1}, "status": {"const": "pass"}, "evidence": {"type": "string", "minLength": 1}}
    },
    "result": {
      "type": "object", "additionalProperties": false, "required": ["finding_id", "status", "evidence"],
      "properties": {"finding_id": {"type": "string", "minLength": 1}, "status": {"const": "implemented-awaiting-rerender"}, "evidence": {"type": "string", "minLength": 1}}
    }
  }
}
