{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design.local/schemas/learning-privacy-review.schema.json",
  "title": "Design Learning Privacy Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "reviewer", "reviewer_kind", "status", "reviewed_artifacts", "checks", "limitations", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "proposal_id": {"type": "string", "minLength": 1},
    "reviewer": {"type": "string", "minLength": 1},
    "reviewer_kind": {"const": "human"},
    "status": {"const": "pass"},
    "reviewed_artifacts": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "checks": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/check"}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "method", "notes"],
      "properties": {
        "id": {"enum": ["private-details", "absolute-paths", "secrets", "benchmark-data"]},
        "status": {"const": "pass"},
        "method": {"type": "string", "minLength": 1},
        "notes": {"type": "string", "minLength": 1}
      }
    }
  }
}
