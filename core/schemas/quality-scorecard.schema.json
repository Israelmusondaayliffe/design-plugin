{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design.local/schemas/quality-scorecard.schema.json",
  "title": "Design Quality Scorecard",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "qa_report", "overall", "dimensions", "blockers", "limitations", "owner", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0"}, "qa_report": {"$ref": "#/$defs/artifact"}, "overall": {"enum": ["pass", "blocked"]}, "dimensions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dimension"}},
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}}, "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}, "owner": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "path": {"type": "string", "minLength": 1},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/hash"}}},
    "dimension": {
      "type": "object", "additionalProperties": false, "required": ["category", "status", "evidence_checks", "notes"],
      "properties": {"category": {"type": "string", "minLength": 1}, "status": {"enum": ["pass", "pass-with-deviation"]}, "evidence_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "notes": {"type": "string", "minLength": 1}}
    }
  }
}
