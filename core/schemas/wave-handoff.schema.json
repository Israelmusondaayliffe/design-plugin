{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design.local/schemas/wave-handoff.schema.json",
  "title": "Design Build Wave Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "wave_id",
    "wave_number",
    "status",
    "manifest_sha256",
    "changed_files",
    "completed_checks",
    "render_results",
    "completion_criteria",
    "known_deviations",
    "new_risks",
    "review_results",
    "next_inputs",
    "rollback_notes",
    "ended_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "wave_id": {"type": "string", "minLength": 1},
    "wave_number": {"type": "integer", "minimum": 1},
    "status": {"enum": ["complete", "blocked"]},
    "manifest_sha256": {"$ref": "#/$defs/hash"},
    "changed_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "change", "sha256", "evidence"],
        "properties": {
          "path": {"$ref": "#/$defs/path"},
          "change": {"enum": ["changed", "deleted"]},
          "sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "completed_checks": {"$ref": "#/$defs/checks"},
    "render_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "status", "evidence"],
        "properties": {
          "target": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "blocked", "not-applicable"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "completion_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "status", "evidence"],
        "properties": {
          "criterion": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "blocked"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "known_deviations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "new_risks": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "review_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewer_id", "role", "status", "evidence"],
        "properties": {
          "reviewer_id": {"type": "string", "minLength": 1},
          "role": {"enum": ["independent-verifier", "unslop-reviewer", "specialist"]},
          "status": {"enum": ["pass", "fail", "blocked"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "next_inputs": {"$ref": "#/$defs/oneOrMoreStrings"},
    "rollback_notes": {"$ref": "#/$defs/oneOrMoreStrings"},
    "ended_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "not": {"pattern": "(^/|(^|/)\\.\\.(/|$)|^[A-Za-z]:)"}},
    "oneOrMoreStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command", "status", "evidence"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "blocked"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
