{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design.local/schemas/implementation-plan.schema.json",
  "title": "Design Implementation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approved_direction_sha256",
    "reference_lock_sha256",
    "ux_definition_sha256",
    "design_md_sha256",
    "quality_targets",
    "repository_change_gate",
    "goal",
    "prohibited_scope",
    "waves",
    "external_actions",
    "approval_artifact"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "approved_direction_sha256": {"$ref": "#/$defs/hash"},
    "reference_lock_sha256": {"$ref": "#/$defs/hash"},
    "ux_definition_sha256": {"$ref": "#/$defs/hash"},
    "design_md_sha256": {"$ref": "#/$defs/hash"},
    "quality_targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/qualityTarget"}},
    "repository_change_gate": {"const": "awaiting_approval"},
    "goal": {"type": "string", "minLength": 8},
    "prohibited_scope": {"$ref": "#/$defs/oneOrMoreStrings"},
    "waves": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "dependencies",
          "goal",
          "inputs",
          "approved_requirements",
          "design_sections",
          "allowed_files",
          "work_items",
          "render_targets",
          "tests",
          "completion_criteria",
          "rollback",
          "risks",
          "status"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "goal": {"type": "string", "minLength": 8},
          "inputs": {"$ref": "#/$defs/oneOrMoreStrings"},
          "approved_requirements": {"$ref": "#/$defs/oneOrMoreStrings"},
          "design_sections": {"$ref": "#/$defs/oneOrMoreStrings"},
          "allowed_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/relativePath"}},
          "work_items": {"$ref": "#/$defs/oneOrMoreStrings"},
          "render_targets": {"$ref": "#/$defs/oneOrMoreStrings"},
          "tests": {"$ref": "#/$defs/oneOrMoreStrings"},
          "completion_criteria": {"$ref": "#/$defs/oneOrMoreStrings"},
          "rollback": {"$ref": "#/$defs/oneOrMoreStrings"},
          "risks": {"$ref": "#/$defs/oneOrMoreStrings"},
          "status": {"const": "planned"}
        }
      }
    },
    "external_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "approval"],
        "properties": {
          "action": {"type": "string", "minLength": 1},
          "approval": {"const": "separate-required"}
        }
      }
    },
    "approval_artifact": {"$ref": "#/$defs/relativePath"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "qualityTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "screen_id", "route", "state", "viewport", "theme", "reduced_motion", "required"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "screen_id": {"type": "string", "minLength": 1},
        "route": {"type": "string", "pattern": "^/"},
        "state": {"type": "string", "minLength": 1},
        "viewport": {"$ref": "#/$defs/viewport"},
        "theme": {"enum": ["light", "dark", "system"]},
        "reduced_motion": {"type": "boolean"},
        "required": {"type": "boolean"}
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "width", "height", "device_scale_factor"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "width": {"type": "integer", "minimum": 240, "maximum": 7680},
        "height": {"type": "integer", "minimum": 240, "maximum": 12000},
        "device_scale_factor": {"type": "number", "minimum": 0.5, "maximum": 4}
      }
    },
    "relativePath": {"type": "string", "minLength": 1, "not": {"pattern": "(^/|(^|/)\\.\\.(/|$)|^[A-Za-z]:)"}},
    "oneOrMoreStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
