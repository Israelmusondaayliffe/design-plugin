{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design.local/schemas/deviations-report.schema.json",
  "title": "Design Deviations Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "qa_report", "deviations", "owner", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0"}, "qa_report": {"$ref": "#/$defs/artifact"}, "deviations": {"type": "array", "items": {"$ref": "#/$defs/deviation"}}, "owner": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "path": {"type": "string", "minLength": 1},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/hash"}}},
    "deviation": {
      "type": "object", "additionalProperties": false, "required": ["finding_id", "target_id", "category", "severity", "disposition", "rationale", "evidence"],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1}, "target_id": {"type": "string", "minLength": 1}, "category": {"type": "string", "minLength": 1}, "severity": {"const": "P3"}, "disposition": {"const": "accepted"}, "rationale": {"type": "string", "minLength": 1}, "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}}
      }
    }
  }
}
