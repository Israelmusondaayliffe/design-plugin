{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design.local/schemas/host-capabilities.schema.json",
  "title": "Design Host Capability Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_status", "inspected_at", "inspector", "surfaces", "figma"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_status": {"enum": ["scaffold", "ready"]},
    "inspected_at": {"type": "string", "format": "date-time"},
    "inspector": {"type": "string", "minLength": 1},
    "surfaces": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "figma": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "provider", "evidence"],
      "properties": {
        "status": {"enum": ["unknown", "unavailable", "available-not-authorized", "available-authorized"]},
        "provider": {"type": ["string", "null"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
