{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design.local/schemas/wave-manifest.schema.json",
  "title": "Design Build Wave Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "wave_id",
    "wave_number",
    "worker_id",
    "plan_json_sha256",
    "approved_plan_artifact",
    "approved_plan_sha256",
    "goal",
    "declared_inputs",
    "artifact_inputs",
    "approved_requirements",
    "design_sections",
    "dependencies",
    "allowed_files",
    "work_items",
    "render_targets",
    "tests",
    "completion_criteria",
    "rollback",
    "planned_risks",
    "control_files",
    "repository_baseline",
    "previous_handoff",
    "status",
    "started_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "wave_id": {"type": "string", "minLength": 1},
    "wave_number": {"type": "integer", "minimum": 1},
    "worker_id": {"type": "string", "minLength": 1},
    "plan_json_sha256": {"$ref": "#/$defs/hash"},
    "approved_plan_artifact": {"$ref": "#/$defs/path"},
    "approved_plan_sha256": {"$ref": "#/$defs/hash"},
    "goal": {"type": "string", "minLength": 8},
    "declared_inputs": {"$ref": "#/$defs/oneOrMoreStrings"},
    "artifact_inputs": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "purpose"],
        "properties": {
          "path": {"$ref": "#/$defs/path"},
          "sha256": {"$ref": "#/$defs/hash"},
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    },
    "approved_requirements": {"$ref": "#/$defs/oneOrMoreStrings"},
    "design_sections": {"$ref": "#/$defs/oneOrMoreStrings"},
    "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "allowed_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/path"}},
    "work_items": {"$ref": "#/$defs/oneOrMoreStrings"},
    "render_targets": {"$ref": "#/$defs/oneOrMoreStrings"},
    "tests": {"$ref": "#/$defs/oneOrMoreStrings"},
    "completion_criteria": {"$ref": "#/$defs/oneOrMoreStrings"},
    "rollback": {"$ref": "#/$defs/oneOrMoreStrings"},
    "planned_risks": {"$ref": "#/$defs/oneOrMoreStrings"},
    "control_files": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/path"}},
    "repository_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "dirty_files", "recorded_at"],
      "properties": {
        "head": {"$ref": "#/$defs/gitOid"},
        "dirty_files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "status", "sha256"],
            "properties": {
              "path": {"$ref": "#/$defs/path"},
              "status": {"type": "string", "minLength": 1},
              "sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]}
            }
          }
        },
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    },
    "previous_handoff": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"$ref": "#/$defs/path"},
            "sha256": {"$ref": "#/$defs/hash"}
          }
        }
      ]
    },
    "status": {"const": "active"},
    "started_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitOid": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
    "path": {"type": "string", "minLength": 1, "not": {"pattern": "(^/|(^|/)\\.\\.(/|$)|^[A-Za-z]:)"}},
    "oneOrMoreStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
