{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design.local/schemas/render-evidence.schema.json",
  "title": "Design Render Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "render_plan", "capture_owner", "server_result", "captures", "limitations", "captured_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["complete", "blocked"]},
    "render_plan": {"$ref": "#/$defs/artifact"},
    "capture_owner": {"type": "string", "minLength": 1},
    "server_result": {
      "type": "object", "additionalProperties": false, "required": ["status", "method", "evidence"],
      "properties": {"status": {"enum": ["pass", "blocked", "not-applicable"]}, "method": {"type": "string", "minLength": 1}, "evidence": {"type": "string", "minLength": 1}}
    },
    "captures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capture"}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "captured_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "not": {"pattern": "(^/|(^|/)\\.\\.(/|$)|^[A-Za-z]:)"}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/hash"}}},
    "capture": {
      "type": "object", "additionalProperties": false, "required": ["target_id", "status", "output", "sha256", "width", "height", "method", "source_url", "evidence", "limitations"],
      "properties": {
        "target_id": {"type": "string", "minLength": 1}, "status": {"enum": ["pass", "blocked", "not-applicable"]}, "output": {"$ref": "#/$defs/path"},
        "sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]}, "width": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]}, "height": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
        "method": {"type": "string", "minLength": 1}, "source_url": {"type": "string", "minLength": 1}, "evidence": {"type": "string", "minLength": 1}, "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
