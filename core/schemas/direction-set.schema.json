{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design.local/schemas/direction-set.schema.json",
  "title": "Design Direction Set",
  "type": "object",
  "required": ["schema_version", "approved_understanding_sha256", "mode", "directions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "approved_understanding_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "mode": {"enum": ["substantial", "bounded-repair"]},
    "direction_strategy": {"enum": ["distinct-primary-foundations", "single-foundation-adaptations"]},
    "directions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "thesis",
          "primary_reference",
          "preserved_primary_traits",
          "secondary_references",
          "dimension_signatures",
          "role_invariants",
          "signature_traits",
          "forbidden_drift",
          "risks",
          "rejected_alternatives",
          "evidence_refs",
          "feasibility",
          "presentation"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["direction_strategy"],
        "properties": {
          "direction_strategy": {"const": "single-foundation-adaptations"}
        }
      },
      "then": {
        "properties": {
          "mode": {"const": "substantial"},
          "directions": {
            "minItems": 3,
            "items": {
              "required": ["adaptation_axis"],
              "properties": {
                "adaptation_axis": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  ]
}
