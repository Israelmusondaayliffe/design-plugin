{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design.local/schemas/image-edit.schema.json",
  "title": "Design Targeted Image Edit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_status", "imagery_plan_sha256", "asset_id", "source_artifact", "source_sha256", "generation_boundary", "repair_pass", "lock", "change", "verify", "prompt"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_status": {"enum": ["scaffold", "ready"]},
    "imagery_plan_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "asset_id": {"type": "string", "minLength": 1},
    "source_artifact": {"type": "string", "minLength": 1, "not": {"pattern": "(^/|(^|/)\\.\\.(/|$)|^[A-Za-z]:)"}},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "generation_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "status", "output_ceiling", "request_sha256", "approval_artifact", "approval_sha256"],
      "properties": {
        "purpose": {"const": "repair-batch"},
        "status": {"enum": ["awaiting-approval", "approved"]},
        "output_ceiling": {"type": "integer", "minimum": 1, "maximum": 50},
        "request_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"},
        "approval_artifact": {"type": ["string", "null"]},
        "approval_sha256": {"type": ["string", "null"]}
      }
    },
    "repair_pass": {"type": "integer", "minimum": 1, "maximum": 3},
    "lock": {"$ref": "#/$defs/oneOrMoreStrings"},
    "change": {"$ref": "#/$defs/oneOrMoreStrings"},
    "verify": {"$ref": "#/$defs/oneOrMoreStrings"},
    "prompt": {"type": "string", "minLength": 20}
  },
  "$defs": {
    "oneOrMoreStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
