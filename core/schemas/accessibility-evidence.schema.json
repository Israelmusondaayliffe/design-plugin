{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design.local/schemas/accessibility-evidence.schema.json",
  "title": "Design Accessibility Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_id", "performed_by", "checks", "limitations", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "target_id": {"type": "string", "minLength": 1},
    "performed_by": {"type": "string", "minLength": 1},
    "checks": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/check"}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "method", "truth_class", "result", "applicability_reason"],
      "properties": {
        "id": {"enum": ["semantics", "accessible-names", "focus", "contrast", "zoom-reflow", "keyboard", "touch-targets", "reduced-motion"]},
        "status": {"enum": ["pass", "fail", "blocked", "not-applicable"]},
        "method": {"type": "string", "minLength": 1},
        "truth_class": {"enum": ["observed", "measured"]},
        "result": {"type": "string", "minLength": 1},
        "applicability_reason": {"type": ["string", "null"]}
      }
    }
  }
}
