{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design.local/schemas/forensic-dossier.schema.json",
  "title": "Design Forensic Dossier",
  "type": "object",
  "required": [
    "schema_version",
    "reference",
    "facts",
    "dimensions",
    "essential_traits",
    "incidental_traits",
    "role_invariants",
    "misuse_risks",
    "evidence_limitations",
    "confidence"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "reference": {
      "type": "object",
      "required": ["slug", "source_url", "source_lane"],
      "properties": {
        "slug": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "minLength": 1},
        "source_lane": {"enum": ["project-local", "user-provided", "corpus", "live-public"]}
      }
    },
    "facts": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["evidence_id", "class", "claim", "source_locator", "confidence"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "class": {"enum": ["observed", "measured", "inferred", "estimated", "recommended", "unknown"]},
          "claim": {"type": "string", "minLength": 8},
          "source_locator": {"type": "string", "minLength": 2},
          "confidence": {"enum": ["high", "medium", "low"]}
        }
      }
    },
    "dimensions": {
      "type": "object",
      "required": ["composition", "typography", "color", "density", "imagery", "motion", "interaction", "hierarchy", "surfaces"]
    },
    "essential_traits": {"type": "array", "minItems": 3, "maxItems": 7, "items": {"type": "string", "minLength": 5}},
    "incidental_traits": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "role_invariants": {"type": "array", "minItems": 3},
    "misuse_risks": {"type": "array", "minItems": 1},
    "evidence_limitations": {"type": "array"},
    "confidence": {"enum": ["high", "medium", "low"]}
  }
}
