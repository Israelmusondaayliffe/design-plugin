{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design.local/schemas/evidence.schema.json",
  "title": "Design Corpus Evidence",
  "type": "object",
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "items": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "claim", "class", "source_url", "locator", "confidence", "captured_at", "notes"],
        "properties": {
          "id": {"type": "string", "pattern": "^E[0-9]{2,}$"},
          "claim": {"type": "string", "minLength": 30},
          "class": {"enum": ["observed", "measured", "inferred", "estimated", "recommended", "unknown"]},
          "source_url": {"type": "string", "pattern": "^https://"},
          "locator": {"type": "string", "minLength": 3},
          "confidence": {"enum": ["low", "medium", "high"]},
          "captured_at": {"type": "string", "format": "date"},
          "notes": {"type": "string", "minLength": 3}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
