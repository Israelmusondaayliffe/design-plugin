{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design.local/schemas/coverage.schema.json",
  "title": "Design Corpus Alpha Coverage",
  "type": "object",
  "required": ["schema_version", "source", "study_date", "platform", "category", "lane_fit", "industry", "archetype", "visual_thesis", "brand_posture", "layout", "grid", "container", "responsive_behavior", "typography", "color", "spacing", "surfaces", "components", "states", "navigation", "forms", "flows", "motion", "interaction", "imagery", "accessibility", "signature_moves", "failure_modes", "suitable_uses", "unsuitable_uses", "confidence", "unknowns"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source": {"type": "string", "minLength": 1},
    "study_date": {"type": "string", "format": "date"},
    "platform": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "lane_fit": {"type": "string", "minLength": 40},
    "industry": {"type": "string", "minLength": 1},
    "archetype": {"type": "string", "minLength": 1},
    "visual_thesis": {"type": "string", "minLength": 20},
    "brand_posture": {"type": "string", "minLength": 10},
    "layout": {"type": "string", "minLength": 10},
    "grid": {"type": "string", "minLength": 10},
    "container": {"type": "string", "minLength": 10},
    "responsive_behavior": {"type": "string", "minLength": 10},
    "typography": {"type": "string", "minLength": 10},
    "color": {"type": "string", "minLength": 10},
    "spacing": {"type": "string", "minLength": 10},
    "surfaces": {"type": "string", "minLength": 10},
    "components": {"type": "string", "minLength": 10},
    "states": {"type": "string", "minLength": 10},
    "navigation": {"type": "string", "minLength": 10},
    "forms": {"type": "string", "minLength": 10},
    "flows": {"type": "string", "minLength": 10},
    "motion": {"type": "string", "minLength": 10},
    "interaction": {"type": "string", "minLength": 10},
    "imagery": {"type": "string", "minLength": 10},
    "accessibility": {"type": "string", "minLength": 10},
    "signature_moves": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 3}},
    "failure_modes": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 3}},
    "suitable_uses": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 3}},
    "unsuitable_uses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "confidence": {"enum": ["low", "medium", "high"]},
    "unknowns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}
  },
  "additionalProperties": false
}
