{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design.local/schemas/review.schema.json",
  "title": "Corpus Editorial Review",
  "type": "object",
  "required": ["schema_version", "status", "result", "author", "reviewer", "independent", "method", "artifact_sha256", "originality_checked", "evidence_checked", "rights_checked", "assets_checked", "reviewed_at", "notes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["private", "review", "public", "blocked"]},
    "result": {"enum": ["pending", "pass", "fail"]},
    "author": {"type": "string", "minLength": 1},
    "reviewer": {"type": "string", "minLength": 1},
    "independent": {"type": "boolean"},
    "method": {"type": "string", "minLength": 10},
    "artifact_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "originality_checked": {"type": "boolean"},
    "evidence_checked": {"type": "boolean"},
    "rights_checked": {"type": "boolean"},
    "assets_checked": {"type": "boolean"},
    "reviewed_at": {"type": "string", "format": "date"},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
